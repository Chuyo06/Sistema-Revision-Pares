# =============================================================================
# SISTEMA DE REVISIÓN POR PARES — Variables de Entorno
# Copia este archivo como .env y completa los valores reales.
# NUNCA subas el archivo .env al repositorio.
# =============================================================================

# ─── GENERAL ──────────────────────────────────────────────────────────────────
NODE_ENV=development
APP_NAME="Sistema de Revisión por Pares"
APP_URL=http://localhost

# ─── API GATEWAY (NestJS) ─────────────────────────────────────────────────────
GATEWAY_PORT=3000
GATEWAY_PREFIX=api

# ─── JWT / AUTENTICACIÓN ──────────────────────────────────────────────────────
JWT_SECRET=cambia_este_secreto_por_uno_seguro
JWT_EXPIRATION=1d
JWT_REFRESH_SECRET=cambia_este_refresh_secreto
JWT_REFRESH_EXPIRATION=7d

# ─── MONGODB ──────────────────────────────────────────────────────────────────
# Manuscritos, embeddings semánticos, logs de LLM
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_USER=admin
MONGO_PASSWORD=password
MONGO_DATABASE=rpp_manuscritos
MONGO_URI=mongodb://admin:password@localhost:27017/rpp_manuscritos

# ─── MARIADB ──────────────────────────────────────────────────────────────────
# Datos transaccionales: usuarios, roles, asignaciones, métricas
MARIADB_HOST=localhost
MARIADB_PORT=3306
MARIADB_USER=rpp_user
MARIADB_PASSWORD=password
MARIADB_DATABASE=rpp_transaccional
MARIADB_ROOT_PASSWORD=root_password

# ─── REDIS ────────────────────────────────────────────────────────────────────
# Sesiones, caché de respuestas LLM, colas de sincronización
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=password
REDIS_TTL=3600

# ─── MICROSERVICIOS — Puertos internos ───────────────────────────────────────
MS_USUARIOS_PORT=3001
MS_MANUSCRITOS_PORT=3002
MS_REVISION_PORT=3003
MS_MATCHING_PORT=3004
MS_ANALISIS_IA_PORT=3005

# ─── LLM / INTELIGENCIA ARTIFICIAL ───────────────────────────────────────────
LLM_PROVIDER=openai
LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
LLM_MODEL=gpt-4o
LLM_BASE_URL=https://api.openai.com/v1
LLM_MAX_TOKENS=4096
LLM_TEMPERATURE=0.3
LLM_CACHE_TTL=86400

# ─── WEB PUSH — Notificaciones Push (VAPID) ──────────────────────────────────
VAPID_PUBLIC_KEY=genera_con_web-push_generate-vapid-keys
VAPID_PRIVATE_KEY=genera_con_web-push_generate-vapid-keys
VAPID_SUBJECT=mailto:admin@rpp.app

# ─── GRAPHQL ──────────────────────────────────────────────────────────────────
GRAPHQL_PLAYGROUND=true
GRAPHQL_DEBUG=true
GRAPHQL_INTROSPECTION=true

# ─── WEBSOCKETS ───────────────────────────────────────────────────────────────
WS_PORT=3100
WS_CORS_ORIGIN=http://localhost:5173

# ─── CORS ─────────────────────────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:5173

# ─── EMAIL (notificaciones) ───────────────────────────────────────────────────
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=587
MAIL_USER=usuario_smtp
MAIL_PASSWORD=password_smtp
MAIL_FROM="RPP Sistema <noreply@rpp.app>"

# ─── ALMACENAMIENTO DE ARCHIVOS ───────────────────────────────────────────────
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./uploads
# Para S3:
# STORAGE_DRIVER=s3
# AWS_BUCKET=rpp-manuscritos
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=AKIAXXXXXXXXXXXXXXXX
# AWS_SECRET_ACCESS_KEY=xxxxxxxxxxxxxxxxxxxxxxxx
