# =============================================================================
# CLIENT — Variables de Entorno (Vue.js + Vite)
# Solo las variables con prefijo VITE_ son expuestas al navegador.
# Copia este archivo como .env y completa los valores reales.
# =============================================================================

# ─── API ──────────────────────────────────────────────────────────────────────
VITE_API_URL=http://localhost:3000/api
VITE_WS_URL=ws://localhost:3100

# ─── GRAPHQL ──────────────────────────────────────────────────────────────────
VITE_GRAPHQL_URL=http://localhost:3000/graphql
VITE_GRAPHQL_WS_URL=ws://localhost:3000/graphql

# ─── WEB PUSH ─────────────────────────────────────────────────────────────────
VITE_VAPID_PUBLIC_KEY=genera_con_web-push_generate-vapid-keys

# ─── PWA ──────────────────────────────────────────────────────────────────────
VITE_APP_NAME="Sistema de Revisión por Pares"
VITE_APP_SHORT_NAME="Rev. Pares"

# ─── FEATURE FLAGS ────────────────────────────────────────────────────────────
VITE_ENABLE_AI_ASSISTANT=true
VITE_ENABLE_OFFLINE_MODE=true
VITE_ENABLE_PUSH_NOTIFICATIONS=true
